---
import { datasets, partners, presentations, publications, webapps } from "../content.js";
import "@fontsource/gothic-a1/latin-400.css";
import "@fontsource/gothic-a1/latin-600.css";
import "@fontsource/gothic-a1/latin-700.css";
import "@fontsource/gothic-a1/latin-800.css";
import globalCss from "../styles/global.css?raw";

const primaryPartners = partners.filter((partner) => partner.tier === "primary");
const secondaryPartners = partners.filter((partner) => partner.tier === "secondary");

const title = "BMM | Bird Migration Modelling";
const description = "Bird Migration Modelling: web apps, publications, presentations, and datasets on nocturnal bird migration measured by weather radar.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("assets/bmm.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content={description}>
    <meta name="theme-color" content="#151515">
    <meta name="color-scheme" content="dark">
    <title>{title}</title>
    <link rel="canonical" href={canonical}>
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={ogImage}>
    <meta name="twitter:card" content="summary">
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EFQJ28R6D2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-EFQJ28R6D2");
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="assets/favicon-16x16.png">
    <style is:inline set:html={globalCss}></style>
  </head>
  <body>
    <main class="layout">
      <aside class="sidebar">
        <div>
          <a class="brand" href="./" aria-label="BMM home">BMM.</a>
          <p class="intro">
            <strong>Bird Migration Modelling</strong> brings together my research projects using weather radar to study bird migration.
            On this website, you'll find different types of resources related to this project:
          </p>
          <nav class="section-nav" aria-label="Page sections">
            <a href="#webapps"><span>01</span><i></i>Webapps</a>
            <a href="#publications"><span>02</span><i></i>Publications</a>
            <a href="#presentations"><span>03</span><i></i>Presentations</a>
            <a href="#datasets"><span>04</span><i></i>Datasets</a>
          </nav>
        </div>

        <footer class="sidebar-footer">
          <div class="partner-block">
            <p class="footer-label">Affiliations &amp; Support</p>
            <div class="partner-logos partner-logos-primary">
              {primaryPartners.map((partner) => (
                <a href={partner.href} target="_blank" rel="noopener" aria-label={partner.label}>
                  <img src={partner.image} alt="">
                </a>
              ))}
            </div>
            <div class="partner-logos partner-logos-secondary">
              {secondaryPartners.map((partner) => (
                <a href={partner.href} target="_blank" rel="noopener" aria-label={partner.label}>
                  <img src={partner.image} alt="">
                </a>
              ))}
            </div>
          </div>
          <ul class="social-links">
            <li><a href="https://raphaelnussbaumer.com/" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm-10 10h20M12 2c2.8 2.7 4 6.1 4 10s-1.2 7.3-4 10c-2.8-2.7-4-6.1-4-10s1.2-7.3 4-10Z"/></svg><span>Personal Website</span></a></li>
            <li><a href="https://github.com/birdmigrationmap" target="_blank" rel="noopener"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg><span>Project Github</span></a></li>
          </ul>
        </footer>
      </aside>

      <div class="content">
        <section id="webapps" class="section section-webapps">
          <h2>Webapps</h2>
          <div class="webapp-list hover-group">
            {webapps.map((app) => (
              <article class="webapp-card" itemscope itemtype="https://schema.org/CreativeWork">
                <a href={app.href} target="_blank" rel="noopener">
                  <img src={app.image} alt="" width="140" height="140" loading="lazy" decoding="async">
                  <div>
                    <p class="eyebrow">{app.label}</p>
                    <h3 itemprop="name">{app.title}</h3>
                    <p>{app.description}</p>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </section>

        <section id="publications" class="section section-publications">
          <h2>Publications</h2>
          <div class="publication-list hover-group">
            {publications.map((publication) => (
              <article class="publication" itemscope itemtype="https://schema.org/CreativeWork">
                <a href={publication.href} target="_blank" rel="noopener">
                  <span class="publication-logo">
                    <img src={publication.image} alt="" loading="lazy">
                  </span>
                  <div>
                    <h3 itemprop="name">{publication.title}</h3>
                    <p>{publication.authors}</p>
                    <strong>{publication.venue}</strong>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </section>

        <section id="presentations" class="section section-presentations">
          <h2>Presentations</h2>
          <div class="publication-list hover-group">
            {presentations.map((presentation) => (
              <article class="publication" itemscope itemtype="https://schema.org/CreativeWork">
                <a href={presentation.href} target="_blank" rel="noopener">
                  <span class="publication-logo">
                    <img src={presentation.image} alt="" loading="lazy">
                  </span>
                  <div>
                    <h3 itemprop="name">{presentation.title}</h3>
                    <p>{presentation.authors}</p>
                    <strong>{presentation.venue}</strong>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </section>

        <section id="datasets" class="section section-datasets">
          <h2>Datasets</h2>
          <div class="dataset-grid hover-group">
            {datasets.map((dataset) => (
              <article class="dataset-card" itemscope itemtype="https://schema.org/Dataset">
                <a href={dataset.href} target="_blank" rel="noopener">
                  <header>
                    <p class="eyebrow">{dataset.label}</p>
                    <img src={dataset.image} alt="" loading="lazy">
                  </header>
                  <h3 itemprop="name">{dataset.title}</h3>
                  {dataset.badge && <img class="doi-badge" src={dataset.badge} alt="DOI" loading="lazy">}
                </a>
              </article>
            ))}
          </div>
        </section>
      </div>
    </main>
    <div class="page-fade top" aria-hidden="true"></div>
    <div class="page-fade bottom" aria-hidden="true"></div>
    <script is:inline>
      // Highlight the sidebar link of the section currently in view.
      const navLinks = new Map(
        [...document.querySelectorAll(".section-nav a")].map((link) => [link.hash.slice(1), link]),
      );
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            for (const link of navLinks.values()) link.removeAttribute("aria-current");
            navLinks.get(entry.target.id)?.setAttribute("aria-current", "true");
          }
        },
        { rootMargin: "-45% 0px -50% 0px" },
      );
      document.querySelectorAll(".section").forEach((section) => observer.observe(section));
    </script>
  </body>
</html>
